# === 법제처 국가법령정보 Open API ===
# open.law.go.kr 에서 발급받은 사용자 지정 인증키(OC)를 넣으세요.
# 이 값은 API 호출용 서버 시크릿입니다. 프론트/브라우저/공식 링크에 절대 노출 금지.
LAW_API_OC=YOUR_LAW_API_OC
LAW_API_BASE_URL=https://www.law.go.kr/DRF

# === Supabase (Project Settings > API) ===
NEXT_PUBLIC_SUPABASE_URL=https://YOUR_PROJECT_REF.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=YOUR_ANON_KEY
SUPABASE_SERVICE_ROLE_KEY=YOUR_SERVICE_ROLE_KEY

# === Vercel Cron ===
CRON_SECRET=generate-random-32chars

# === Admin UI 비밀번호 (Cron secret과 다른 값으로!) ===
ADMIN_SECRET=generate-random-32chars-different

# === 수집기 튜닝 ===
COLLECTOR_BATCH_SIZE=15
COLLECTOR_STALE_MINUTES=15
COLLECTOR_MAX_ATTEMPTS=5

# === Postgres (Supabase Project Settings > Database > Connection string) ===
# Transaction pooler (port 6543) — app runtime
DATABASE_URL=postgresql://postgres.YOUR_PROJECT_REF:YOUR_DB_PASSWORD@aws-0-ap-northeast-2.pooler.supabase.com:6543/postgres?pgbouncer=true
# Direct connection (port 5432) — prisma migrate only
DIRECT_URL=postgresql://postgres.YOUR_PROJECT_REF:YOUR_DB_PASSWORD@aws-0-ap-northeast-2.pooler.supabase.com:5432/postgres

# === Email delivery (Round 5.5b) ===
# Resend (https://resend.com) API key. 없으면 콘솔 로그 fallback.
RESEND_API_KEY=
# 발신 주소 - 인증된 도메인이어야 실 발송 성공.
EMAIL_FROM=LawCheck <no-reply@your-domain.com>

# === Storage (Round 5.5a) ===
# Supabase Storage 버킷 이름. 기본 "evidence". 대시보드에서 이 이름의 private 버킷 생성 필요.
SUPABASE_EVIDENCE_BUCKET=evidence

# === Auth advisory lock (Round 5.1.2) - 튜닝 필요 없음, 기본값 사용
# COLLECTOR_PROGRESS_LOCK_STALE_MS=300000
# INBOX_FANOUT_BATCH=50
# NOTIF_DELIVERY_BATCH=50
